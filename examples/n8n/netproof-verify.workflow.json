        "options": {}
      },
      "id": "831e6053-3a42-4f42-9531-b658f590ad43",
      "name": "NetProof /api/verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// NetProof가 준 comparison을 그대로 쓴다. 이 노드는 문장만 만든다.\nconst TITLE = { PASS: '통과', DENY: '막힘', INVALID: '입력 오류', UNSUPPORTED: '판정 불가' };\nconst request = $('NetProof 검증 요청 받기').first().json.body;\nreturn $input.all().map(({ json: verdict }) => {\n  const answer = `AI 답(${TITLE[request.ai_expected] ?? '없음'})과`;\n  const message = verdict.comparison === 'AGREE' ? `= ${answer} NetProof 계산이 같습니다`\n    : verdict.comparison === 'DISAGREE' ? `≠ ${answer} NetProof 계산(${TITLE[verdict.result]})이 다릅니다`\n    : `NetProof 계산 ${TITLE[verdict.result] ?? verdict.result}`;\n  return { json: { message, comparison: verdict.comparison, result: verdict.result, reason: verdict.reason,\n    problems: verdict.problems, notify: verdict.comparison === 'DISAGREE' } };\n});"
      },
      "id": "2f4b4eb2-4724-4c49-a6fa-a88bff041b06",
